<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="39.67dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/widget_preview_claude_weekly"
            android:padding="3dp"
            android:src="@drawable/ic_provider_claude" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:max="100"
                android:progress="49"
                android:progressBackgroundTint="@color/widget_progress_track"
                android:progressTint="@color/widget_healthy" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:alpha="0.75"
                android:max="100"
                android:progress="56"
                android:progressBackgroundTint="@color/widget_progress_track"
                android:progressTint="@color/widget_elevated" />
        </LinearLayout>

        <TextView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/widget_preview_49"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/widget_preview_reset_claude"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="39.67dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/widget_preview_codex_weekly"
            android:padding="3dp"
            android:src="@drawable/ic_provider_codex" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="47"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_healthy" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/widget_preview_47"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/widget_preview_reset_codex"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="39.67dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/widget_preview_grok_weekly"
            android:padding="3dp"
            android:src="@drawable/ic_provider_grok" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="99"
            android:progressBackgroundTint="@color/widget_progress_track"
            android:progressTint="@color/widget_high" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/widget_preview_99"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="@string/widget_preview_reset_grok"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/widget_sync_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_preview_synced"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
